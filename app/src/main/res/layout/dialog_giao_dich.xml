<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@+id/rbExpense">

            <RadioButton
                android:id="@+id/rbIncome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Khoản thu"
                android:textColor="#0F766E" />

            <RadioButton
                android:id="@id/rbExpense"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Khoản chi"
                android:textColor="#C65035" />

        </RadioGroup>

        <TextView
            style="@style/Label"
            android:text="Số tiền VND"
            android:labelFor="@+id/edtAmount" />

        <EditText
            android:id="@id/edtAmount"
            style="@style/Field"
            android:hint="Ví dụ: 150000"
            android:inputType="number"
            android:digits="0123456789"
            android:maxLength="12"
            android:singleLine="true" />

        <TextView
            style="@style/Label"
            android:text="Tên giao dịch"
            android:labelFor="@+id/edtTitle" />

        <EditText
            android:id="@id/edtTitle"
            style="@style/Field"
            android:hint="Ví dụ: Ăn trưa, Lương tháng 11"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:singleLine="true" />

        <TextView
            style="@style/Label"
            android:text="Phân loại giao dịch"
            android:labelFor="@+id/spCategory" />

        <Spinner
            android:id="@id/spCategory"
            style="@style/Field"
            android:spinnerMode="dropdown" />

        <TextView
            style="@style/Label"
            android:text="Ngày và giờ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDate"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="3"
                android:text="Chọn ngày" />

            <Button
                android:id="@+id/btnTime"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:text="Chọn giờ" />

        </LinearLayout>

        <TextView
            style="@style/Label"
            android:text="Ghi chú không bắt buộc"
            android:labelFor="@+id/edtNote" />

        <EditText
            android:id="@id/edtNote"
            style="@style/Field"
            android:hint="Thêm thông tin cho giao dịch"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:minLines="2"
            android:maxLines="4"
            android:maxLength="300" />

    </LinearLayout>

</ScrollView>